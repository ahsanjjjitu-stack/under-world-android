<?xml version="1.0" encoding="utf-8"?>
<!-- Text field background. setActivated(true) = red error border, focused = orange border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/uw_surface" />
            <stroke android:width="1dp" android:color="@color/uw_error" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/uw_surface" />
            <stroke android:width="1dp" android:color="#FF6B3D" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/uw_surface" />
            <stroke android:width="1dp" android:color="@color/uw_line" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>