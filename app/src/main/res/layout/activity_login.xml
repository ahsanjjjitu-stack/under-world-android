<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uw_bg"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Brand row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_logo">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="U"
                    android:textColor="#0D1017"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="UNDER WORLD"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Floating product cards -->
        <FrameLayout
            android:id="@+id/stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Left card -->
            <FrameLayout
                android:id="@+id/cardLeft"
                android:layout_width="110dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_paper"
                android:elevation="14dp"
                android:rotation="-10"
                android:translationX="-98dp"
                android:translationY="14dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_garment_brief_navy" />
            </FrameLayout>

            <!-- Right card -->
            <FrameLayout
                android:id="@+id/cardRight"
                android:layout_width="110dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_mint"
                android:elevation="14dp"
                android:rotation="10"
                android:translationX="98dp"
                android:translationY="20dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_garment_boxer_moss" />
            </FrameLayout>

            <!-- Middle card (on top) -->
            <FrameLayout
                android:id="@+id/cardMiddle"
                android:layout_width="110dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_card_peach"
                android:elevation="18dp"
                android:translationY="-18dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_garment_trunk_ember" />
            </FrameLayout>
        </FrameLayout>

        <!-- Title, button and legal text -->
        <LinearLayout
            android:id="@+id/bottomBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="26dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Hey Welcome to \nUnder World"
                android:textColor="@color/uw_text"
                android:textSize="30sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Sign in to keep your bag safe and track your orders."
                android:textColor="@color/uw_muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Continue with Google button -->
            <LinearLayout
                android:id="@+id/btnGoogle"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_google_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gMark"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_gmark"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="G"
                    android:textColor="@color/uw_gmark_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <ProgressBar
                    android:id="@+id/googleProgress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/uw_google_text"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/googleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Continue with Google"
                    android:textColor="@color/uw_google_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnGuest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="Continue as guest"
                android:textColor="@color/uw_muted"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="By continuing you agree to our Terms and Privacy Policy."
                android:textColor="@color/uw_legal"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
