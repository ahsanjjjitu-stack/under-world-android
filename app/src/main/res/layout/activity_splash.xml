<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1017"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Logo, wordmark and tagline, centred -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Pulsing ring (behind the logo card) -->
            <View
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ring"
                android:importantForAccessibility="no" />

            <!-- Orange rounded square with the U drawn inside -->
            <FrameLayout
                android:id="@+id/logoCard"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_logo_splash">

                <ImageView
                    android:id="@+id/logoU"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/avd_logo_u"/>
            </FrameLayout>
        </FrameLayout>

        <!-- Letters of UNDER WORLD are added here from SplashActivity -->
        <LinearLayout
            android:id="@+id/wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:clipChildren="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Go deeper into comfort."
            android:textColor="@color/uw_muted"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Small loading bar near the bottom -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="3dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="64dp"
        android:background="@color/uw_line">

        <View
            android:id="@+id/progressFill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF6B3D" />
    </FrameLayout>
</FrameLayout>
