<?xml version="1.0" encoding="utf-8"?>
<!-- Payment option row. Selected = orange border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/uw_surface2" />
            <stroke android:width="1.5dp" android:color="@color/uw_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/uw_surface" />
            <stroke android:width="1.5dp" android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>