<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.UnderWorld" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/uw_bg</item>
        <item name="android:statusBarColor">@color/uw_bg</item>
        <item name="android:navigationBarColor">@color/uw_bg</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
00
    <style name="RoundedImageOrder">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedImage_Details">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">30dp</item>
    </style>

    <style name="Theme.UnderWorld" parent="Base.Theme.UnderWorld" />




    <!-- Text field used on the checkout screen -->
    <style name="Widget.UnderWorld.Input" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:textColor">@color/uw_text</item>
        <item name="android:textColorHint">@color/uw_legal</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:importantForAutofill">yes</item>
    </style>

    <!-- Small label above a field -->
    <style name="Widget.UnderWorld.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/uw_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Red message under a field. Hidden (gone) until there is an error. -->
    <style name="Widget.UnderWorld.FieldError" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/uw_error</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Big step title (Where to deliver?) -->
    <style name="Widget.UnderWorld.StepTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.UnderWorld.StepSub" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/uw_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>



</resources>